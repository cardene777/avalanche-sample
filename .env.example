# Avalanche Testnet RPCs
DISPATCH_RPC_URL=https://subnets.avax.network/dispatch/testnet/rpc
ECHO_RPC_URL=https://subnets.avax.network/echo/testnet/rpc

# TeleporterMessenger Contract Addresses (deployed on testnets)
# Update these with actual deployed addresses
DISPATCH_TELEPORTER_ADDRESS=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf
ECHO_TELEPORTER_ADDRESS=0x253b2784c75e510dD0fF1da844684a1aC0aa5fcf

# Smart Contract Addresses (deploy these in Phase 2)
# Leave empty until contracts are deployed
ERC3009_TOKEN_ADDRESS=
PAYMENT_REGISTRY_ADDRESS=
CONTENT_ACCESS_MANAGER_ADDRESS=

# Facilitator Configuration
# SECURITY: Never commit this file with real private keys!
# Use a dedicated testnet account with limited funds
FACILITATOR_PRIVATE_KEY=your_private_key_here

# Merchant/Recipient address for payments
MERCHANT_ADDRESS=your_merchant_address_here

# Frontend Configuration (automatically set by docker-compose)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:5000

# Optional: JWT secret for payment proofs
JWT_SECRET=change_this_to_a_random_secret

# Optional: Node environment
NODE_ENV=development
