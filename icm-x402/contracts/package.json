{
  "name": "x402-paywall-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for x402 paywall with Avalanche ICM",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:dispatch": "hardhat run scripts/deploy-token.ts --network dispatch && hardhat run scripts/deploy-payment-registry.ts --network dispatch",
    "deploy:echo": "hardhat run scripts/deploy-content-access.ts --network echo",
    "mint": "hardhat run scripts/mint-tokens.ts --network dispatch"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "hardhat": "^2.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^17.2.3"
  }
}
