# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Echo Chain (Content Access Manager)
ECHO_RPC_URL=https://subnets.avax.network/echo/testnet/rpc
CONTENT_ACCESS_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Dispatch Chain (Payment Token)
DISPATCH_RPC_URL=https://subnets.avax.network/dispatch/testnet/rpc
PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Facilitator Service
FACILITATOR_URL=http://localhost:5000

# Payment Token Metadata (for EIP-712)
TOKEN_NAME=PaymentToken
TOKEN_VERSION=1
DISPATCH_CHAIN_ID=123456

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
