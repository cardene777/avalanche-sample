# Git
.git/
.gitignore
.gitattributes

# Dependencies
node_modules/
*/node_modules/

# Build artifacts (exclude from Docker context)
dist/
build/
*/dist/
*/build/
.next/
*/.next/

# Environment files (use Docker secrets/env instead)
.env*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
logs/

# Documentation
README.md
docs/
*.md
!quickstart.md

# Specs and planning (not needed in container)
specs/
.specify/

# IDE
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/
*/coverage/

# Docker files (don't copy Docker files into Docker)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Hardhat / Foundry cache (rebuild in container)
cache/
artifacts/
contracts/cache/
contracts/artifacts/
contracts/out/

# Temporary files
*.tmp
*.swp
*.bak
