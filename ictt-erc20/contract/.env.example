# デプロイ用のプライベートキー
PRIVATE_KEY=your_private_key_here

# ====================
# Home Chain（トークンの発行元）
# ====================
HOME_RPC_URL=your_home_rpc_url
HOME_BLOCKCHAIN_ID=your_home_blockchain_id
HOME_TELEPORTER_REGISTRY=your_home_teleporter_registry

# ====================
# Remote Chain（転送先）
# ====================
REMOTE_RPC_URL=your_remote_rpc_url
REMOTE_BLOCKCHAIN_ID=your_remote_blockchain_id
REMOTE_TELEPORTER_REGISTRY=your_remote_teleporter_registry

# ====================
# デプロイ済みコントラクトアドレス
# ====================
# TOKEN_ADDRESS=
# HOME_ADDRESS=
# REMOTE_ADDRESS=
